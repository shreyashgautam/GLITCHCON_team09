# ─── PUT YOUR KEYS HERE ───────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here
GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here

# ─── DATABASE (MongoDB) ────────────────────────────────────
# Required to use DB-backed ingestion + RAG context.
MONGO_URI=mongodb://127.0.0.1:27017/medai
# Optional: explicit DB name (otherwise uses DB from URI)
MONGO_DB_NAME=medai

# ─── TWILIO WHATSAPP ──────────────────────────────────────
# Get these from console.twilio.com
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=+14155238886
# ^ This is Twilio's shared sandbox number — don't change it for sandbox testing

# Optional — user can override from Settings UI
OPENAI_API_KEY=

# Server
PORT=4000
FRONTEND_URL=http://localhost:5173

# For production (Render)
# FRONTEND_URL=https://your-vercel-app.vercel.app
